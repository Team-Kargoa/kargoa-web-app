# Copy this file to .env and adjust as needed. Every variable below has a
# working default (see lib/config.ts), so the app runs with no .env at all —
# this file exists purely as a discoverable reference for what can be tuned.
#
# PUBLIC vs SERVER-ONLY
# ----------------------
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time and is world-readable — never put a secret behind that prefix.
# Variables without the prefix are read only in server-side code (Server
# Components, Route Handlers, middleware) and are never sent to the client.

# --- Public --------------------------------------------------------------

# Base URL of the Kargoa backend API.
# Default: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Support/engineering contact address shown on the placeholder Contact page.
# Default: engineering@kmercargo.cm
NEXT_PUBLIC_SUPPORT_EMAIL=engineering@kmercargo.cm

# OTP request rate limit shown in the 429 rate-limit error copy. Must match
# apps/accounts/services/otp.py:RATE_LIMIT in the Kargoa-backend repo — the
# backend enforces the real limit; this only controls what the UI says.
# Default: 3
NEXT_PUBLIC_OTP_RATE_LIMIT=3

# OTP request rate limit window, in minutes, shown in the same copy. Must
# match apps/accounts/services/otp.py:RATE_WINDOW_SECONDS (600s = 10min) in
# the Kargoa-backend repo.
# Default: 10
NEXT_PUBLIC_OTP_RATE_WINDOW_MINUTES=10

# --- Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser) ----

# Access token cookie max-age, in seconds. Must match
# SIMPLE_JWT.ACCESS_TOKEN_LIFETIME in config/settings/base.py in the
# Kargoa-backend repo (currently 15 minutes) — a mismatch either signs
# users out early or keeps a cookie alive past what the backend still
# honors.
# Default: 900 (15 minutes)
SESSION_ACCESS_MAX_AGE=900

# Refresh token cookie max-age, in seconds. Must match REFRESH_TTL in
# apps/accounts/services/token.py in the Kargoa-backend repo (currently
# 30 days).
# Default: 2592000 (30 days)
SESSION_REFRESH_MAX_AGE=2592000
